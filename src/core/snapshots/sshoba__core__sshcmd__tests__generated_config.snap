# Generated by sshoba. Do not edit.

Host sshoba.bastion
    HostName 203.0.113.10
    User ata
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host sshoba.db-prod
    HostName 10.0.0.5
    User postgres
    Port 2222
    ProxyJump sshoba.bastion

Host sshoba.*
    ControlMaster auto
    ControlPath /home/u/.local/state/sshoba/ctl/%C
    ControlPersist 10m

Host *
Include ~/.ssh/config
Include /etc/ssh/ssh_config
